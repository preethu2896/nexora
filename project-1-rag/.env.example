# Gemini API or OpenAI API Configuration
# Option A: Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: OpenAI API Key or Custom Endpoint
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# LLM & Embedding Model Settings (Defaults to gemini-2.5-flash and text-embedding-004 when Gemini key is used)
LLM_MODEL_NAME=gemini-2.5-flash
EMBEDDING_MODEL_NAME=text-embedding-004

# Document Chunking Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval Settings
TOP_K=4

# Paths
DATA_DIR=./data
CHROMA_DB_DIR=./chroma_db

# Application Settings
LOG_LEVEL=INFO
